# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Homepage Configuration
# Set to 'true' to show the Watch Demo button on the homepage
NEXT_PUBLIC_SHOW_DEMO_BUTTON=false

# AI Chat Configuration
# Set to 'false' to require login before accessing AI chat
# Set to 'true' or leave unset to allow anonymous users (2 message limit)
NEXT_PUBLIC_ALLOW_ANONYMOUS_AI_CHAT=true

# AI Reasoning Feature
# Set to 'true' or leave unset to allow users to expand and view the AI's thinking process
# Set to 'false' to only show a "Reasoning..." indicator without expandable content
NEXT_PUBLIC_ALLOW_REASONING_PREVIEW=true